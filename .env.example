# Copy to .env and replace every value. .env is git-ignored; this file holds placeholders only.
# docker compose reads .env from this directory, and the local Spring profile imports it too.
# Nothing has a default: a missing value stops compose or the application at startup.

# Superuser of the PostgreSQL container. Used once, by ops/postgres/init, to create the two roles
# below and the database. Neither Flyway nor the application connects with it.
POSTGRES_BOOTSTRAP_PASSWORD=change-me-bootstrap

# recon_migrator: owns the schema and runs the Flyway migrations.
RECON_DB_MIGRATOR_PASSWORD=change-me-migrator

# recon_app: the role the application connects as. Owns nothing and cannot run DDL (V1__baseline.sql).
RECON_DB_APP_PASSWORD=change-me-app

# Published loopback ports. The defaults keep clear of the ledger's local stack.
POSTGRES_PORT=5434
KAFKA_PORT=9094

# HTTP Basic users (TDD 11.1), one per role: the operator uploads statements, the viewer reads.
# Each hash is bcrypt. The placeholders are not hashes, so the application refuses to start until
# both are replaced. Make one with this PowerShell command; it asks for the password twice, without
# echo, and prints only the hash (the jar is in the local repository after the first build):
#   java -cp "$HOME\.m2\repository\org\springframework\security\spring-security-crypto\7.1.1\spring-security-crypto-7.1.1.jar" ops\security\HashPassword.java
# Keep the single quotes: docker compose reads this file too, and would take each $ in a hash as
# the start of a variable. The application drops one enclosing pair.
RECON_OPERATOR_USERNAME=operator-001
RECON_OPERATOR_PASSWORD_HASH='replace-with-a-bcrypt-hash'
RECON_VIEWER_USERNAME=viewer-001
RECON_VIEWER_PASSWORD_HASH='replace-with-a-bcrypt-hash'
