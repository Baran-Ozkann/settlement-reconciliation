# Keeps files identical whatever editor writes them: the repository is read by reviewers, and a
# diff full of re-indentation or line-ending churn hides the change it is supposed to show.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,md}]
indent_size = 2

[*.md]
# Two trailing spaces are a line break in Markdown, so trimming them changes the rendered text.
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf

[Makefile]
indent_style = tab
